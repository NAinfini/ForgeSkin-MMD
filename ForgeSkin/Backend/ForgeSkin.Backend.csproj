<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The editor ships a self-contained single-file publish. The single-file analyzer would add the ILLink package of the
         installed SDK to the publish restore, which packages.lock.json cannot pin across SDK patches; it only flags
         Assembly.Location, which the backend does not use (AppContext.BaseDirectory). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- The skin format library, shared source with the game plugin. -->
    <Compile Include="..\Core\*.cs" />
    <!-- ForgeCore's one relative-path rule, which pack entry names pass. -->
    <Compile Include="..\..\ForgeCore\Once\PosixPath.cs" Link="ForgeCore\PosixPath.cs" />
    <!-- ForgeCore's one FNV-1a hash: the skin numbers and content hashes of a teammate's look (Core/Look.cs). -->
    <Compile Include="..\..\ForgeCore\Once\Fnv.cs" Link="ForgeCore\Fnv.cs" />
    <!-- The skin format's code effects are checked against ForgeCore's drawing-program catalogue: its reader and the catalogue
         itself, the same files ForgeCore.dll is built from. -->
    <Compile Include="..\..\ForgeCore\Visual\Core\ProceduralCatalog.cs" Link="ForgeCore\ProceduralCatalog.cs" />
    <EmbeddedResource Include="..\..\ForgeCore\Visual\Data\fx-programs.json" LogicalName="ForgeVisual.Data.fx-programs.json" />
    <!-- ForgeCore's one sRGB/linear conversion (pure), for the DDS decode of an adopted pack's textures. -->
    <Compile Include="..\..\ForgeCore\Visual\Core\ColourSpace.cs" Link="ForgeCore\ColourSpace.cs" />
    <!-- ForgeCore's one chain physics (charm ropes, spring bones), pure; the plugin's through ForgeCore.dll. -->
    <Compile Include="..\..\ForgeCore\Visual\Core\ChainPhysics.cs" Link="ForgeCore\ChainPhysics.cs" />
    <!-- Character skins (Core/Character.cs): ForgeCore's canonical humanoid, its rest-pose check and the imported-model descriptor with its
         one file check (and the PNG header reader it uses), pure; the plugin's through ForgeCore.dll. -->
    <Compile Include="..\..\ForgeCore\Visual\Core\JointClip.cs;..\..\ForgeCore\Visual\Core\JointClipGlb.cs;..\..\ForgeCore\Visual\Core\RigMap.cs;..\..\ForgeCore\Visual\Core\JointRetarget.cs;..\..\ForgeCore\Visual\Core\BodyRig.cs;..\..\ForgeCore\Visual\Core\ImportedModelFormat.cs;..\..\ForgeCore\Once\Png.cs" Link="ForgeCore\%(Filename)%(Extension)" />
    <!-- Pack sounds pass the same Ogg Vorbis check the game's audio kit applies when it loads them. -->
    <Compile Include="..\..\ForgeCore\Audio\Core\AssetValidation.cs;..\..\ForgeCore\Audio\Core\Results.cs" Link="ForgeCore\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decodes a pack's compressed textures back to PNG when a work is adopted (BC1/BC3/BC4/BC5/BC7); managed, no native code (MIT). -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <!-- PNG/JPEG decode and encode, high-quality resizing and compositing for packs and pictures (Microsoft-maintained, MIT). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>

</Project>
